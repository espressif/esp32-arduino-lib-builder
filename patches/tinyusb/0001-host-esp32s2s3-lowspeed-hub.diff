+static uint32_t _status_next_ms = 0;
+
+// bNbrPorts is only set once the hub descriptor has been read, so it also rules out a hub that is
+// still being configured — ep_in alone is set from hub_open(), much earlier.
+TU_ATTR_ALWAYS_INLINE static inline bool hub_status_configured(const hub_interface_t* p_hub) {
+  return p_hub->ep_in != 0 && p_hub->bNbrPorts != 0;
+}
+
+// The status chain re-arms itself after every event it handles, but each of those calls is a
+// one-shot: should hub_edpt_status_xfer() fail — endpoint still claimed, transfer rejected by the
+// controller — nothing ever tries again and the hub is deaf for good. Attach and detach are then
+// simply never reported, while already-mounted devices keep working, which is indistinguishable
+// from a dead port. Re-arm idle hubs periodically so deafness is bounded by HUB_STATUS_REARM_MS.
+void hub_status_watchdog(void) {
+  const uint32_t now_ms = tusb_time_millis_api();
+  if ((int32_t)(now_ms - _status_next_ms) < 0) {
+    return;
+  }
+  _status_next_ms = now_ms + HUB_STATUS_REARM_MS;
+
+  for (uint8_t i = 0; i < CFG_TUH_HUB; i++) {
+    if (hub_status_configured(&hub_itfs[i])) {
+      // no-op while a status transfer is genuinely in flight: the claim fails and we try again later
+      hub_edpt_status_xfer((uint8_t)(i + 1 + CFG_TUH_DEVICE_MAX));
+    }
+  }
+}
+
+// The host task blocks on its event queue, and a deaf hub is exactly the case where no event will
+// arrive to wake it, so the watchdog would never get a second chance to run. Report how long the
+// task may sleep for. Only a hub whose status endpoint is idle asks for a bounded sleep: while every
+// hub has a transfer in flight, which is the normal state, nothing here needs waking up at all.
+uint32_t hub_status_watchdog_wait_ms(void) {
+  for (uint8_t i = 0; i < CFG_TUH_HUB; i++) {
+    const uint8_t daddr = (uint8_t)(i + 1 + CFG_TUH_DEVICE_MAX);
+    if (hub_status_configured(&hub_itfs[i]) && !usbh_edpt_busy(daddr, hub_itfs[i].ep_in)) {
+      const int32_t left_ms = (int32_t)(_status_next_ms - tusb_time_millis_api());
+      return left_ms > 0 ? (uint32_t)left_ms : 0;
+    }
+  }
+  return UINT32_MAX;
+}
+
+// A status transfer that is simply waiting for a change is indistinguishable from one the
+// controller has wedged, so nothing periodic can tell them apart while it stays claimed. The one
+// moment we know the endpoint has to be listening is right after a device below the hub was torn
+// down: usbh closes channels there, and a status transfer pending across that teardown can be lost,
+// leaving the hub deaf for good. Drop it and let hub_status_watchdog() start a fresh one.
+// Re-arming here instead would submit onto a channel that is still being disabled — hcd only
+// requests the halt, the channel is released later from the interrupt.
+// No event is lost: the hub holds its change bits until they are cleared.
+void hub_status_abort_pending(uint8_t daddr) {
+  hub_interface_t* p_hub = get_hub_itf(daddr);
+  TU_VERIFY(p_hub->ep_in != 0 && p_hub->bNbrPorts != 0, );
+  tuh_edpt_abort_xfer(daddr, p_hub->ep_in); // skipped internally if the endpoint is not busy
+}
+
