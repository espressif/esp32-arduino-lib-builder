+{
+#if CONFIG_BT_TBS
+    if (attr != NULL && attr->uuid != NULL &&
+            attr->uuid->type == BT_UUID_TYPE_16 &&
+            BT_UUID_16(attr->uuid)->val == BT_UUID_TBS_URI_LIST_VAL &&
+            data != NULL && len > 0 &&
+            ((const char *)data)[len - 1] == ',') {
+        len--;
+    }
+#endif /* CONFIG_BT_TBS */
+    return bt_gatt_notify(conn, attr, data, len);
+}
