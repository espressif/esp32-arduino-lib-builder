+/* Strip the synthetic trailing ',' stored for libble_audio.a's
+ * uri_scheme_in_list() so over-the-air ATT Read / Notify values of Bearer URI
+ * Schemes Supported List (0x2BB6) conform to Bluetooth TBS v1.0 sec. 3.4. */
+static ssize_t audio_gatts_attr_read(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                     void *buf, uint16_t buf_len, uint16_t offset,
+                                     const void *value, uint16_t value_len)
+{
+#if CONFIG_BT_TBS
+    if (attr != NULL && attr->uuid != NULL &&
+            attr->uuid->type == BT_UUID_TYPE_16 &&
+            BT_UUID_16(attr->uuid)->val == BT_UUID_TBS_URI_LIST_VAL &&
+            value != NULL && value_len > 0 &&
+            ((const char *)value)[value_len - 1] == ',') {
+        value_len--;
+    }
+#endif /* CONFIG_BT_TBS */
+    return bt_gatt_attr_read(conn, attr, buf, buf_len, offset, value, value_len);
+}
+
+static int audio_gatts_notify_uuid(struct bt_conn *conn, const struct bt_uuid *uuid,
+                                   const struct bt_gatt_attr *attr,
