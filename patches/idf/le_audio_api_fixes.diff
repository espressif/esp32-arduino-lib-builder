+/* uri_scheme_in_list() in prebuilt libble_audio.a only matches scheme tokens
+ * followed by ','. Append an internal trailing ',' (stripped on GATT Read /
+ * Notify in init.c so over-the-air 0x2BB6 PDUs conform to TBS v1.0 sec. 3.4). */
+static const char *tbs_normalize_uri_schemes(const char *schemes,
+                                             char buf[CONFIG_BT_TBS_MAX_SCHEME_LIST_LENGTH + 2])
+{
+    size_t len;
+
+    if (schemes == NULL) {
+        return NULL;
+    }
+
+    len = strlen(schemes);
+    if (len > 0 && schemes[len - 1] != ',' && len <= CONFIG_BT_TBS_MAX_SCHEME_LIST_LENGTH) {
+        memcpy(buf, schemes, len);
+        buf[len] = ',';
+        buf[len + 1] = '\0';
+        return buf;
+    }
+
+    return schemes;
+}
