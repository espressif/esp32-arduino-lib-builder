+        return 1;
+    }
+    /* Use the lowest value handle, not list order, as the Find Info start. */
+    start = first->chrc.val_handle;
+    SYS_SLIST_FOR_EACH_CONTAINER(chrc_list, it, node) {
+        if (it->chrc.val_handle < start) {
+            start = it->chrc.val_handle;
+        }
