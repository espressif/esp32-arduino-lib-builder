+ *
+ * @return 0 if a discovery was started, 1 if there is nothing to discover,
+ *         or a negative error (NimBLE reports its errors as positive values).
+ */
+static int gattc_db_disc_svc_dscs(struct gattc_db *adb, sys_slist_t *chrc_list,
+                                  uint16_t svc_end, ble_gatt_dsc_fn *cb, void *cb_arg)
