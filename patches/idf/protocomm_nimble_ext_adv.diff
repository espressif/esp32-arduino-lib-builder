 /*****************************************************************************************/
 /*                             SIMPLE BLE INTEGRATION                                    */
 /*****************************************************************************************/
+#if MYNEWT_VAL(BLE_EXT_ADV)
+/* Legacy-PDU advertising must use the last extended advertising instance,
+ * matching the Arduino BLE library's legacy advertising path. */
+#define PROTOCOMM_BLE_EXT_ADV_INSTANCE (BLE_ADV_INSTANCES - 1)
+
+static int
+simple_ble_ext_adv_set_data(const struct ble_hs_adv_fields *fields, bool scan_rsp)
+{
+    uint8_t buf[BLE_HS_ADV_MAX_SZ];
+    uint8_t len;
+    int rc = ble_hs_adv_set_fields(fields, buf, &len, sizeof(buf));
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* ble_gap_ext_adv_set_data/rsp_set_data take ownership of the mbuf. */
+    struct os_mbuf *om = ble_hs_mbuf_from_flat(buf, len);
+    if (om == NULL) {
+        return BLE_HS_ENOMEM;
+    }
+
+    return scan_rsp ? ble_gap_ext_adv_rsp_set_data(PROTOCOMM_BLE_EXT_ADV_INSTANCE, om)
+                    : ble_gap_ext_adv_set_data(PROTOCOMM_BLE_EXT_ADV_INSTANCE, om);
+}
+
+static int
+simple_ble_ext_advertise(void)
+{
+    struct ble_gap_ext_adv_params params = {0};
+    int rc;
+
+    params.connectable = 1;
+    params.scannable = 1;
+    params.legacy_pdu = 1;
+    params.itvl_min = 0x100;
+    params.itvl_max = 0x100;
+    params.own_addr_type = own_addr_type;
+
+    rc = ble_gap_ext_adv_configure(PROTOCOMM_BLE_EXT_ADV_INSTANCE, &params, NULL,
+                                   simple_ble_gap_event, NULL);
+    if (rc != 0 && rc != BLE_HS_EALREADY) {
+        return rc;
+    }
+
+    rc = simple_ble_ext_adv_set_data(&adv_data, false);
+    if (rc != 0) {
+        return rc;
+    }
+
+    rc = simple_ble_ext_adv_set_data(&resp_data, true);
+    if (rc != 0) {
+        return rc;
+    }
+
+    /* 0 means no expiration for the extended advertising API. */
+    return ble_gap_ext_adv_start(PROTOCOMM_BLE_EXT_ADV_INSTANCE, 0, 0);
+}
+#endif
+
 static void
 simple_ble_advertise(void)
 {
