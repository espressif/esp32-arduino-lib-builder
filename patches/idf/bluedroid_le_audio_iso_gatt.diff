+
+    if (bt_le_bluedroid_gatts_sem_take()) {
+        LOG_ERR("[B]SvcDeleteFail[0x%04x]", svc->attrs[0].handle);
+        return -1;
+    }
+
     svc->attrs[0].handle = 0;
 
     return 0;
