 }
 
+struct bt_gatt_attr *bt_le_bluedroid_audio_find_attr_by_handle(uint16_t handle)
+{
+    for (uint8_t i = 0; i < created_svc_count; i++) {
+        struct bt_gatt_service *svc = created_svcs[i];
+
+        if (svc == NULL || svc->attrs == NULL) {
+            continue;
+        }
+
+        for (size_t j = 0; j < svc->attr_count; j++) {
+            if (svc->attrs[j].handle == handle) {
+                return &svc->attrs[j];
+            }
+        }
+    }
+
+    return NULL;
+}
