+void bt_iso_acl_disconnected(uint16_t acl_handle, uint8_t reason)
+{
+#if CONFIG_BT_ISO_UNICAST
+    struct bt_conn *acl = bt_le_acl_conn_find(acl_handle);
+
+    if (acl == NULL || acl->state != BT_CONN_DISCONNECTED) {
+        return;
+    }
+
+    for (size_t i = 0; i < ARRAY_SIZE(iso_conns); i++) {
+        struct bt_conn *iso = &iso_conns[i];
+        struct bt_iso_chan *chan;
+
+        if (iso->type != BT_CONN_TYPE_ISO || iso->iso.acl != acl) {
+            continue;
+        }
+
+        chan = iso->iso.chan;
+        if (chan == NULL) {
+            bt_iso_cleanup_acl(iso);
+            continue;
+        }
+
+        if (chan->state != BT_ISO_STATE_DISCONNECTED) {
+            LOG_WRN("IsoAclLostCis[%u][0x%03x]", acl_handle, iso->handle);
+            bt_iso_chan_disconnected(chan, reason);
+        } else {
+            bt_iso_cleanup_acl(iso);
+        }
+    }
+#else
+    ARG_UNUSED(acl_handle);
+    ARG_UNUSED(reason);
+#endif /* CONFIG_BT_ISO_UNICAST */
+}
