#
# Harvest-only delta: appended for libbt.matter.a (CHIPoBLE min NimBLE RAM).
# Not a standalone target. Overrides defconfig.common large pools (30x512).
# ESP-Matter: docs/en/optimizations.rst#ble-optimizations
# SMP stays enabled for Matter pairing.
#

# Roles (peripheral commissioning)
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
# CONFIG_BT_NIMBLE_GATT_CLIENT is not set

CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_WHITELIST_SIZE=1
# CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1

CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=100
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
# CONFIG_BT_NIMBLE_MSYS_BUF_FROM_HEAP is not set
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=5
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=3

# Legacy sdkconfig aliases (some IDF versions)
CONFIG_BT_NIMBLE_MSYS1_BLOCK_COUNT=10
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=5
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=5
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=3
CONFIG_NIMBLE_MAX_BONDS=2
CONFIG_NIMBLE_MAX_CONNECTIONS=1
CONFIG_NIMBLE_MAX_CCCDS=2
# CONFIG_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_NIMBLE_ROLE_OBSERVER is not set
