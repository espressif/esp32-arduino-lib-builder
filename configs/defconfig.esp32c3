CONFIG_RTC_CLK_CAL_CYCLES=576
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2304
CONFIG_BT_ENABLED=y
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_SCAN_CACHE=y
CONFIG_ESP_WIFI_MBO_SUPPORT=y
CONFIG_ESP_WIFI_11R_SUPPORT=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Matter settings: CHIPoBLE on. Endpoint count stays at common (7):
# C3 has no PSRAM; 32 would not fit a typical Arduino Matter + NimBLE image.
CONFIG_ENABLE_CHIPOBLE=y
