# DISABLED: Bluedroid host overlay, used only to compile-test the
# BLE library (including LE Audio / ISO) against Bluedroid. The builder only
# reads configs/defconfig.<name>, so this file is never picked up. To use it,
# copy it to configs/defconfig.bluedroid and apply it last on top of the
# normal target stack, e.g. for the S31:
#   ./build.sh -s -t esp32s31 -b idf-libs qio 80m_250m opi_ram bluedroid
# Build with the same IDF_PATH as the published libs.

CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y

# Host ISO on Bluedroid (also selected by CONFIG_BT_ISO; explicit as in the
# esp_ble_audio examples).
CONFIG_BT_BLE_FEAT_ISO_EN=y
# PAST: Broadcast Assistant sends it, Scan Delegator / Broadcast Sink receive it.
CONFIG_BT_BLE_FEAT_PERIODIC_ADV_SYNC_TRANSFER=y

# Bluedroid counterparts of CONFIG_BT_NIMBLE_MAX_CCCDS for the many LE Audio
# services and client subscriptions. 32 is the Kconfig maximum (the target
# defconfig asks for 48, which Bluedroid rejects).
CONFIG_BT_GATT_MAX_SR_PROFILES=32
CONFIG_BT_GATTC_NOTIF_REG_MAX=64

# Matter's Bluedroid BLEManagerImpl does not build on the S31, and it is
# irrelevant to this BLE test:
#  - with Matter-over-Thread it calls ThreadStackMgr().OnCHIPoBLEAdvertisingStop(),
#    which does not exist;
#  - it uses BT_CONTROLLER_INIT_CONFIG_DEFAULT(), whose S31 definition takes
#    the address of a compound literal, which is invalid C++.
CONFIG_ENABLE_MATTER_OVER_THREAD=n
CONFIG_ENABLE_CHIPOBLE=n
